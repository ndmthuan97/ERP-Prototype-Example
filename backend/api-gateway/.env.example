# ============================================================
# API Gateway — environment variables
# ============================================================
# Single entry point: verifies the app access token (JWT), checks the session
# whitelist in Redis, then reverse-proxies to the backend services.

# --- JWT (app access token) ---
# HS256, shared with auth-service. Payload: { sub, email, role, fullName, sid }.
JWT_SECRET=your-super-secret-jwt-key-change-this

# --- Upstash Redis (REST) — session whitelist ---
# From: Upstash Dashboard -> Redis -> Details.
# The gateway reads session:<sid> on every protected request (instant revoke +
# idle timeout). Must be the SAME instance auth-service writes sessions to.
UPSTASH_REDIS_REST_URL=https://[your-redis-id].upstash.io
UPSTASH_REDIS_REST_TOKEN=[your-token]

# Session idle-timeout in seconds. getex slides this TTL on each authorized
# request; a session idle longer than this is treated as expired. Default 1800.
GATEWAY_SESSION_IDLE_SEC=1800

# --- Server ---
PORT=3010

# --- Downstream service URLs ---
AUTH_SERVICE_URL=http://localhost:3004
CUSTOMER_SERVICE_URL=http://localhost:3001
ORDER_SERVICE_URL=http://localhost:3002
INVENTORY_SERVICE_URL=http://localhost:3003
CATALOG_SERVICE_URL=http://localhost:3005
PURCHASING_SERVICE_URL=http://localhost:3006

# --- Hardening ---
# CORS whitelist (comma-separated). Empty falls back to http://localhost:3000.
CORS_ORIGINS=http://localhost:3000
GLOBAL_RATE_LIMIT=100
LOGIN_RATE_LIMIT=5

# --- Service-to-service auth (Cloud Run) ---
# Set to "id-token" to force Google ID-token minting for all targets. Otherwise
# tokens are minted only for *.run.app targets (localhost stays credential-free).
# SERVICE_AUTH_MODE=id-token
